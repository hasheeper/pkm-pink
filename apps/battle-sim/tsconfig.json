{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": [
    "types/**/*.d.ts",
    "battle/battle-calc.js",
    "battle/battle-damage.js",
    "battle/battle-effects.js",
    "battle/battle-turns.js",
    "battle/battle-switch.js",
    "engine/battle-engine.js",
    "engine/move-handlers.js",
    "engine/ai-engine.js",
    "systems/pp-system.js"
  ],
  "exclude": [
    "ST",
    "dist",
    "node_modules",
    "data",
    "docs"
  ]
}
