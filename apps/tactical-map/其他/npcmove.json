            "morning":   { "action": "Labor",    "target": "Shop:Wares_General", "rigidity": 0.9 },
            
            // [正午] 进食=补给。
            // 不同于别人的Enjoy，她是Fueling。会哪怕离的很远也会去找便宜量大的店。
            "noon":      { "action": "Refuel",   "target": "Shop:Diner", "rigidity": 0.4 }, 
            
            // [下午] 接受委托/巡逻。
            // 可能会出现在 Viewpoint 张望是否有恐怖的头目宝可梦(其实没有)。
            "afternoon": { "action": "Patrol",   "target": "Place:Viewpoint", "rigidity": 0.8 }, 
            
            // [傍晚] 趁着天黑前赶紧回家，或者买打折便当。
            "evening":   { "action": "Gather",   "target": "Shop:Shop_Kiosk", "rigidity": 0.6 },
            
            // [夜晚] 绝对不出门。
            // 对她来说，晚上的城市=百鬼夜行。Rigidity 锁死。
            "night":     { "action": "Hide",     "target": "home_id",   "rigidity": 1.0 },
            "midnight":  { "action": "Sleep",    "target": "home_id",   "rigidity": 1.0 } 
        }
    },

    // ----------------------------------------------------
    // [3] Spatial Calculation (空间算法)
    // ----------------------------------------------------
    /* 
       逻辑：古代人的脚力惊人，她是能徒手爬天冠山的女人。
       penalty_exponent 0.9: 极低惩罚。她完全不介意走路。
       哪怕为了省5块钱的路费，她也愿意横跨两个大区。
       hard_radius 60: 基本上全图都是她的步行范围。
    */
    "spatial_profile": {
        "penalty_exponent": 0.9, // 跑图高手
        "hard_radius": 60,       // 为了接到只有远方才有的委托(Quest)，她哪里都去
        "k_nearest_cap": 5       // 会认真对比哪家店最便宜
    },

    // ----------------------------------------------------
