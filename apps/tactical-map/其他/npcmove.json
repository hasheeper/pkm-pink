    "hobbies_weights": {
        "Diner": 0.60,       // 唯一的花销：吃
        "Nature_Spot": 0.30, // 找一点有泥土气息的地方待着
        "Shop_Browsk": 0.10, // 偶尔会对现代商品感到好奇
        "Arcade": 0.0,       // 噪音会导致应激反应
        "Bar": 0.0,          // 拒绝酒精
        "Relax": 0.0         // "我这种人没资格休息"
    },

    // ----------------------------------------------------
    // [5] Indiv. Overrides (例外时刻)
    // ----------------------------------------------------
    "solo_mood_overrides": {
        
        // 场景：周末去寻找"家乡的味道" (芋饼猎人)
