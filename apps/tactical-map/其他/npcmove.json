
"Sonia": {
    // ----------------------------------------------------
    // [1] Geo-Location & Identity (基础定位)
    // ----------------------------------------------------
    "base_zone": "Zenith", 
    "home_id": "Sonia_Rhodia_Central_Lab", // 地图实际 Entity ID

    // ----------------------------------------------------
    // [2] Routine Entropy System (日常与熵)
    // ----------------------------------------------------
    /* 
       逻辑：She is employed (Standard pattern).
       base_entropy 0.3: 代表她有30%的本我欲望想逃离工作。
       Calculated chance to deviate = Entropy * (1.0 - Rigidity) * Multiplier
    */
    "pattens": "Standard", // Mon-Fri: Matrix ACTIVE; Sat-Sun: FREE (Subject to Overrides)

    "routine_profile": {
        "base_entropy": 0.3, 
        
        // 这一栏仅在一个普通的 "Work Day" 生效
        "daily_matrix": {            
            // [黎明/深夜] 秩序极高，几乎都在室内，除非剧情特殊事件。
            "dawn":      { "action": "Sleep",    "target": "home_id",   "rigidity": 0.8 },        
            "midnight":  { "action": "Sleep",    "target": "home_id",   "rigidity": 0.9 },

            // [上班] 刚性极高的一段。想让她早退很难。
            "morning":   { "action": "Research", "target": "home_id",   "rigidity": 0.95 },
            
            // [午休] 刚性极低(0.5)。很容易被熵值和 hunger mood 击穿，导致她跑出去吃。
            "noon":      { "action": "Eat",      "target": null,        "rigidity": 0.5 }, 
            
            // [下午] 开会。刚性回升。
            "afternoon": { "action": "Meeting",  "target": "home_id",   "rigidity": 0.9 },
            
            // [傍晚] 刚性 0.6。典型的"在加班和回家之间仰卧起坐"。
            "evening":   { "action": "Overtime", "target": "home_id",   "rigidity": 0.6 },
            
            // [夜晚] 如果还在公司，此刻刚性归零。必然触发 Hobbies 或 Solo Overrides。
            "night":     { "action": "Free",     "target": null,        "rigidity": 0.0 } 
        }
    },

    // ----------------------------------------------------
    // [3] Spatial Calculation (空间算法参数)
    // ----------------------------------------------------
    /* 
       逻辑：索妮亚体力差、是室内派、穿高跟鞋。
       她的惩罚指数极高 (3.0)，意味着如果目标超过 20 格，吸引力分数会断崖式下跌。
       她几乎只会在 Z区(Zenith) 内部选点，除非有强力 Override 修正系数。
    */
    "spatial_profile": {
        "penalty_exponent": 3.0, // 距离每增加，意愿按立方级下降 (懒人中的懒人)
        "hard_radius": 25,       // 她甚至不愿意跨过主干道
        "k_nearest_cap": 2       // 只看最近的两家店，懒得挑
    },

    // ----------------------------------------------------
    // [4] Preference Weights (兴趣权重)
    // ----------------------------------------------------
    // 当上述 Routine 被打断，或者处于 Free Time 时使用
    "hobbies_weights": {
        "Cafe": 0.6,        // 咖啡是刚需 (Z区就有)
        "Study": 0.3,       // 图书馆 (Z区也有)
        "Nature_Spot": 0.1, // 只有想不到去哪才逛花园
        "Bar": 0.0          // 工作日绝不喝酒
    },

    // ----------------------------------------------------
    // [5] Indiv. Overrides (特定时段覆盖) - 你的需求重点
    // ----------------------------------------------------
    /* 
       逻辑：即使是懒人，到了周末(Weekend)或特定心情时，
       会强制修改空间参数 (temp_mod)，允许她远行。
    */
    "solo_mood_overrides": {
        
        // 场景：周末晚上一定要喝一杯，奖励自己
        "weekend_night": { 
            "target_type": "Bar",
            // 索妮亚觉得 S区的酒不好喝，但 N区(Neon) 那个高空酒吧适合此时的心情
            "preferred_zone": "Neon", 
            
            // [关键]: 临时修正她的懒惰属性，允许她这就坐捷运过去
            "temp_spatial_mod": { 
                "penalty_exponent": 0.5, // 暂时变为了"为了这杯酒多远都行"
                "hard_radius": 100       // 解除范围锁
            }
        },

        // 场景：周末中午去盛绽区(Bloom)做美容/吃饭
        "weekend_noon": { 
            // 这是一个数组，表示系统可以在这几个里选
            "target_options": [
                { "type": "Relax", "zone": "Bloom" }, // 去找莉佳的 SPA
                { "type": "Diner", "zone": "Bloom" }  // 吃海鲜
            ],
            // 同样给予特权，解除距离限制
            "temp_spatial_mod": { "penalty_exponent": 1.0, "hard_radius": 80 }
        }
    }
},


"Gloria": {
    // ----------------------------------------------------
    // [1] Geo-Location & Identity (基础定位)
    // ----------------------------------------------------
    "base_zone": "Apex",
    "home_id": "Gloria_Camp_Curry", // [12, 25] 南部黄土/草地交界处的帐篷

    // ----------------------------------------------------
    // [2] Routine Entropy System (日常与熵)
    // ----------------------------------------------------
    /* 
       逻辑：Pattern = "Free"。她没有朝九晚五。
       base_entropy 0.8: 高得离谱。哪怕你给她安排了任务，她也有80%的冲动想跑去别的地方玩。
       她的行动几乎完全由 Interest 和 Mood 驱动，而不是 Duty。
    */
    "pattens": "Free", 

    "routine_profile": {
        "base_entropy": 0.8, // 自由的伽勒尔冠军，很难坐得住
        
        "daily_matrix": {            
            // [黎明] 少数的高秩序时刻。为了生存，必须在营地把状态补满。
            "dawn":      { "action": "Cook",     "target": "home_id",   "rigidity": 0.85 }, 

            // [上午] 探索时间。虽没有强制工作，默认会在营地附近晃悠采集。
            // 但 entorpy 0.8 + rigidity 0.4 = 几乎必定会跑去稍远的地方。
            "morning":   { "action": "Gather",   "target": "home_id",   "rigidity": 0.4 },
            
            // [正午] 肚子饿了。如果不触发 Override 去吃好的，就会在最近的食堂解决。
            "noon":      { "action": "Eat",      "target": null,        "rigidity": 0.3 }, 
            
            // [下午] 锻炼。虽然这是她的"工作"，但她把这当娱乐。
            "afternoon": { "action": "Train",    "target": "Shop:Cafe", "rigidity": 0.2 }, 
            
            // [傍晚] 营地篝火准备。
            "evening":   { "action": "Logistics","target": "home_id",   "rigidity": 0.5 },
            
            // [深夜] 回帐篷睡觉。A区晚上全是强力宝可梦，乱跑会死。
            "night":     { "action": "Sleep",    "target": "home_id",   "rigidity": 0.9 }, 
            "midnight":  { "action": "Sleep",    "target": "home_id",   "rigidity": 1.0 } 
        }
    },

    // ----------------------------------------------------
    // [3] Spatial Calculation (空间算法参数)
    // ----------------------------------------------------
    /* 
       逻辑：伽勒尔人的膝盖是铁做的。
       penalty_exponent 0.8: 几乎接近线性/随机。哪怕是地图另一端，只要好玩她就会考虑。
       hard_radius 40: 她的搜索半径非常大，几乎能覆盖 A + Z + B 三个大区。
    */
    "spatial_profile": {
        "penalty_exponent": 0.8, // "距离只会增加旅行的乐趣" (普通人是2.0左右)
        "hard_radius": 40,       // 地图对角线约70格，40能让她覆盖70%的地图
        "k_nearest_cap": 6       // 她喜欢比对多家店铺，不只是选最近的
    },

    // ----------------------------------------------------
    // [4] Preference Weights (兴趣权重)
    // ----------------------------------------------------
    // 一个吃货战斗狂的自我修养
    "hobbies_weights": {
        "Nature_Spot": 0.45, // 找树果、食材、野生对战
        "Diner": 0.30,       // 饭量很大
        "Plaza": 0.15,       // 看热闹/人群
        "Viewpoint": 0.10,   // 寻找极巨坑/旷野地带既视感
        "Work": 0.0          // 这种锚点对她没有任何吸引力
    },

    // ----------------------------------------------------
    // [5] Indiv. Overrides (特定时段个人修正)
    // ----------------------------------------------------
    "solo_mood_overrides": {
        
        // 场景：周末晚上想要热闹
        // Gloria 在 A区(Apex) ，去 S区(Shadow) 是地图最远对角线，必须接触参数限制。
        "weekend_night": { 
            "target_type": "Bar", // 目标：酒吧/特别是LiveHouse
            "preferred_zone": "Shadow", 
            
            // 空间模块超频：进入"旷野自行车"模式
            "temp_spatial_mod": { 
                "penalty_exponent": -0.5, // 负数！越远的地方越刺激！
                "hard_radius": 200,       // 全图限制解除
                "k_nearest_cap": 2        // 这么远就不挑了，直奔最有名的两家
            }
        },

        // 场景：周末中午改善伙食 (吃海鲜)
        "weekend_noon": { 
            "target_options": [
                { "type": "Diner", "zone": "Bloom" }, // 海鲜食堂
                { "type": "Cafe",  "zone": "Bloom" }  // 果汁店
            ],
            // 修正系数：Bloom区对她来说算中远距离，稍微放松一点即可
            "temp_spatial_mod": { 
                "penalty_exponent": 0.5, // 更加愿意跑路
                "hard_radius": 50 
            }
        }
    }
}

"Rosa": {
    // ----------------------------------------------------
    // [1] Geo-Location (基础定位)
    // ----------------------------------------------------
    "base_zone": "Neon", // 霓虹区是她的主场 (最适合街拍)
    "home_id": "Rosa_PokeStar_Studios", // [38, 32] 位于 N 区核心

    // ----------------------------------------------------
    // [2] Routine Entropy System (熵值系统)
    // ----------------------------------------------------
    /* 
       逻辑：Pattern = "Service" (特殊服务业)。
       她的工作时间和大众错位（别人下班她上班）。
       base_entropy 0.45: 中等偏高。她精力旺盛，但有很强的“人设包袱”。
       她不会像小优那样真的是在“漫无目的乱跑”，她的每次乱跑通常都是为了
       “探店 / 寻找灵感 / 秘密特训”。
    */
    "pattens": "Service", 

    "routine_profile": {
        "base_entropy": 0.45,  // 好奇心强，容易被新鲜事物吸引
        
        "daily_matrix": {            
            // [黎明] 偶像的自我修养，早起做造型/发声练习。
            // rigidity 0.9: 极高，这时候一定要在事务所。
            "dawn":      { "action": "Makeup",   "target": "home_id",   "rigidity": 0.9 }, 

            // [上午] 拍摄/彩排。
            // 虽然是工作，但可能要去外景，target=HOME只是默认集合点。
            "morning":   { "action": "Filming",  "target": "home_id",   "rigidity": 0.8 },
            
            // [正午] 偶像不能吃太饱，要在潮流店打卡。
            // Rigidity 0.4: 这个点很容易去 N区 或 Z区 的网红咖啡店。
            "noon":      { "action": "Diet",     "target": "Shop:Cafe", "rigidity": 0.4 }, 
            
            // [下午] 粉丝见面 / 演技练习。
            // 可能会出现在人多的 Plaza (为了曝光度)。
            "afternoon": { "action": "Event",    "target": "Place:Plaza", "rigidity": 0.7 }, 
            
            // [傍晚] 自由时间/甚至可能会去陪练。
            // 前冠军的实力会在这时显露。
            "evening":   { "action": "Training", "target": "home_id",   "rigidity": 0.5 },
            
            // [夜晚] 直播营业 / 或者是单纯的打游戏
            "night":     { "action": "Live",     "target": "home_id",   "rigidity": 0.8 },
            
            // [深夜] 终于卸妆也是真正自由的时候。
            // Rigidity 0.2: 有可能 sneaking out 去买零食或者街机厅。
            "midnight":  { "action": "Secret",   "target": "home_id",   "rigidity": 0.2 } 
        }
    },

    // ----------------------------------------------------
    // [3] Spatial Calculation (空间算法)
    // ----------------------------------------------------
    /* 
       逻辑：为了拍出好照片，她愿意跑，但必须是有捷运直达的地方。
       penalty_exponent 1.5: "适度的挑剔"。比普通人更能跑，但不如小优疯。
       k_nearest_cap 4: 她会对比“众里寻他千百度”的那家店，只要品质好，距离不是问题。
    */
    "spatial_profile": {
        "penalty_exponent": 1.5, // 只要是为了工作/美，距离惩罚降低
        "hard_radius": 35,       // N区去Z区(20格)、B区(30格)都在舒适区内
        "k_nearest_cap": 4       // 会对比最近的4个选项，从中选最好的
    },

    // ----------------------------------------------------
    // [4] Preference Weights (兴趣权重)
    // ----------------------------------------------------
    // 关键词：潮流、视野、玩乐
    "hobbies_weights": {
        "Arcade": 0.35,      // 设定上很喜欢热闹和电子游戏
        "Shop_Browsk": 0.30, // 巡视流行趋势（逛街）
        "Cafe": 0.20,        // 它是甜食党
        "Viewpoint": 0.15,   // 自拍点
        "Diner": 0.0         // 偶像不可以吃油腻的大排档（除非特殊Override）
    },

    // ----------------------------------------------------
    // [5] Indiv. Overrides (微服私访模式)
    // ----------------------------------------------------
    "solo_mood_overrides": {
        
        // 场景：周末正午去海滨度假拍照
        "weekend_noon": { 
            "target_type": "Viewpoint",
            "preferred_zone": "Bloom", // 锁定盛绽区（海滩）
            
            // 空间修正：为了完美的Ins照片，必须去最漂亮的那个点
            "temp_spatial_mod": { 
                "penalty_exponent": 0.0, // 完全无视距离
                "hard_radius": 100,      // 全图打击
                "k_nearest_cap": 1       // 指名道姓要去最有名的那个海滩
            }
        },

        // 场景：夜晚心情不好的时候（Secret Gamer Mode）
        // “既然戴了口罩，就去离家远一点的街机厅大杀四方吧”
        "weekday_night": { 
            "target_type": "Arcade",
            // 故意不去 N 区（也就是家门口）的街机厅，怕遇到粉丝
            // 而是可能会选择 S 区 (Shadow) 那个比较破的
            "preferred_zone": "Shadow", 
            "temp_spatial_mod": { 
                "penalty_exponent": 1.0, 
                "hard_radius": 50 
            }
        }
    }
},
