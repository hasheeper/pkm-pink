        "weekend_noon": { 
            "target_type": "Diner",
            "preferred_zone": "Bloom", // 离 S 区很远，但为了吃……
            
            // 古代人的执着
            "temp_spatial_mod": { 
                "penalty_exponent": -0.2, // 变成负数，意思是"特意要去远的这家"
                "hard_radius": 200,
                "k_nearest_cap": 1 // 锁定名为 "Alo-Ola" 的那家食堂
            }
        },

        // 场景：被现代社会的压力击垮时的逃避
        // 去 A区(Apex) 的荒原，因为那里像红莲湿地
        "weekday_evening": { 
            "target_type": "Nature_Spot",
            "preferred_zone": "Apex", 
